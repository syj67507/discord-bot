# This the configuration for lavalink but done through environment variables
# Sensitive values are not to be checked in but will need to be filled when copying these
# configurations to the container running lavalink
_JAVA_OPTIONS="-Xmx512M"

SERVER_PORT=443
SERVER_ADDRESS=0.0.0.0
LAVALINK_PLUGINS_0_DEPENDENCY=com.github.topi314.lavasrc:lavasrc-plugin:4.6.0
LAVALINK_PLUGINS_0_SNAPSHOT=false
LAVALINK_PLUGINS_1_DEPENDENCY=dev.lavalink.youtube:youtube-plugin:0e5cfca4e88c32db430ce76e6866b13035c85d22
LAVALINK_PLUGINS_1_SNAPSHOT=true

LAVALINK_SERVER_PASSWORD=

LAVALINK_SERVER_SOURCES_YOUTUBE=false
LAVALINK_SERVER_SOURCES_BANDCAMP=true
LAVALINK_SERVER_SOURCES_SOUNDCLOUD=true
LAVALINK_SERVER_SOURCES_TWITCH=true
LAVALINK_SERVER_SOURCES_VIMEO=true
LAVALINK_SERVER_SOURCES_NICO=true

LAVALINK_SERVER_SOURCES_HTTP=false

LAVALINK_SERVER_SOURCES_LOCAL=false
PLUGINS_LAVASRC_SOURCES_SPOTIFY=true
PLUGINS_LAVASRC_PROVIDERS_0=ytsearch:"%ISRC%"
PLUGINS_LAVASRC_PROVIDERS_1=ytsearch:%QUERY%

PLUGINS_LAVASRC_SPOTIFY_CLIENT_ID=

PLUGINS_LAVASRC_SPOTIFY_CLIENT_SECRET=

PLUGINS_LAVASRC_SPOTIFY_PLAYLIST_LOAD_LIMIT=6
PLUGINS_LAVASRC_SPOTIFY_COUNTRY_CODE=US
PLUGINS_LAVASRC_SPOTIFY_RESOLVE_ARTISTS_IN_SEARCH=true
PLUGINS_LAVASRC_SPOTIFY_ALBUM_LOAD_LIMIT=6
PLUGINS_LAVASRC_SPOTIFY_LOCAL_FILE=false
PLUGINS_YOUTUBE_ENABLED=true
PLUGINS_YOUTUBE_ALLOW_SEARCH=true
PLUGINS_YOUTUBE_ALLOW_DIRECT_VIDEOS_IDS=true
PLUGINS_YOUTUBE_ALLOW_DIRECT_PLAYLIST_IDS=true
PLUGINS_YOUTUBE_OAUTH_ENABLED=true

PLUGINS_YOUTUBE_OAUTH_REFRESH_TOKEN=

PLUGINS_YOUTUBE_OAUTH_SKIP_INITIALIZATION=true
